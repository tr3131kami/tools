<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TOOLS DIRECTORY</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-base: #0f172a;
      --card-bg: rgba(30, 41, 59, 0.6);
      --accent-cyan: #06b6d4;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: 'Space Grotesk', sans-serif;
      min-height: 100vh;
      background-image: radial-gradient(circle at 15% 50%, rgba(6, 182, 212, 0.08), transparent 25%),
                        radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.08), transparent 25%);
    }

    .container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
    header { margin-bottom: 40px; text-align: center; }
    header h1 { font-size: 2.5rem; letter-spacing: 2px; text-transform: uppercase; }
    header h1 span { color: var(--accent-cyan); }

    .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }

    .card {
      background: var(--card-bg);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 24px;
      backdrop-filter: blur(12px);
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .card:hover { transform: translateY(-5px); border-color: var(--accent-cyan); }

    .access-btn {
      display: inline-block;
      text-decoration: none;
      color: var(--bg-base);
      background: linear-gradient(135deg, var(--accent-cyan), #3b82f6);
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
    }

    /* モーダル用 */
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(8px);
      display: flex; justify-content: center; align-items: center;
      z-index: 1000; opacity: 0; visibility: hidden; transition: all 0.3s ease;
    }
    .modal-overlay.active { opacity: 1; visibility: visible; }
    .modal-content {
      background: #1e293b; padding: 40px; border-radius: 20px; max-width: 600px; width: 90%;
      border: 1px solid var(--accent-cyan); transform: scale(0.9); transition: transform 0.3s ease;
    }
    .modal-overlay.active .modal-content { transform: scale(1); }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <h1>Tools<span>_</span>Directory</h1>
    </header>
    <div id="tools-grid" class="tools-grid"></div>
  </div>

  <script>
    // ⚠️ ここを設定してください
    const SERVICE_DOMAIN = 'あなたのサービスドメイン'; 
    const API_KEY = 'あなたのAPIキー'; 
    const ENDPOINT = 'tools';

    async function fetchTools() {
      const res = await fetch(`https://${SERVICE_DOMAIN}.microcms.io/api/v1/${ENDPOINT}`, {
        headers: { 'X-MICROCMS-API-KEY': API_KEY }
      });
      const data = await res.json();
      renderTools(data.contents);
    }

    function renderTools(tools) {
      const grid = document.getElementById('tools-grid');
      tools.forEach(tool => {
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <h2>${tool.title}</h2>
          <p>${tool.description}</p>
          <a href="${tool.url}" target="_blank" class="access-btn">Access Tool</a>
        `;
        card.addEventListener('click', (e) => {
          if (!e.target.classList.contains('access-btn')) openModal(tool);
        });
        grid.appendChild(card);
      });
    }

    function openModal(tool) {
      const overlay = document.createElement('div');
      overlay.className = 'modal-overlay';
      overlay.innerHTML = `
        <div class="modal-content">
          <h2>${tool.title}</h2>
          <p>${tool.detail || '詳細情報はありません。'}</p>
          <a href="${tool.url}" target="_blank" class="access-btn">Access Tool</a>
          <button onclick="this.closest('.modal-overlay').remove()" style="margin-left:10px; background:transparent; border:1px solid #94a3b8; color:#fff; padding:10px 20px; cursor:pointer;">Close</button>
        </div>
      `;
      document.body.appendChild(overlay);
      setTimeout(() => overlay.classList.add('active'), 10);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
    }

    fetchTools();
  </script>
</body>
</html>
